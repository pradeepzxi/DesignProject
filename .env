# Environment Configuration for Link Integrity Management Platform
ENVIRONMENT=development
DEBUG=True
APP_NAME="Intelligent Link Integrity Management Framework"
API_V1_PREFIX=/api

# Database
DATABASE_URL=sqlite:///./data/link_integrity.db

# Storage Directories
DATA_DIR=./data
DOCUMENTS_DIR=./data/documents
CANDIDATE_PAGES_DIR=./data/candidate_pages
EXPERIMENTS_DIR=./data/experiments

# Link Validation Engine Settings
VALIDATION_TIMEOUT_SECONDS=10.0
VALIDATION_MAX_RETRIES=2
VALIDATION_BACKOFF_FACTOR=1.5
VALIDATION_MAX_CONCURRENCY=10
VALIDATION_RATE_LIMIT_PER_DOMAIN=3
VALIDATION_CACHE_TTL_SECONDS=3600
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36 (LinkIntegrityBot/1.0 Research)"

# Security / SSRF Protection
SSRF_PROTECTION_ENABLED=True
ALLOWED_SCHEMES=http,https

# CORS Settings
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
